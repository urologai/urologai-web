{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urologai.org/contracts/v1/schemas/public-release.schema.json",
  "title": "UrologAI v1 sanitized public release",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "release_id", "release_sequence", "parent_release_id", "release_state", "status_epoch", "contract_bundle_sha256", "content_sha", "web_sha", "public_tree_sha256", "status_snapshot_sha256", "article_revisions", "evidence_cutoff", "created_at"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "release_id": {"$ref": "common.schema.json#/$defs/release_id"},
    "release_sequence": {"type": "integer", "minimum": 1},
    "parent_release_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/release_id"}, {"type": "null"}]},
    "release_state": {"enum": ["active", "superseded"]},
    "status_epoch": {"type": "integer", "minimum": 0},
    "contract_bundle_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "content_sha": {"$ref": "common.schema.json#/$defs/git_object_id"},
    "web_sha": {"$ref": "common.schema.json#/$defs/git_object_id"},
    "public_tree_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "status_snapshot_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "article_revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["article_id", "article_revision_id", "path", "sha256"],
        "properties": {
          "article_id": {"$ref": "common.schema.json#/$defs/article_id"},
          "article_revision_id": {"$ref": "common.schema.json#/$defs/article_revision_id"},
          "path": {"type": "string", "pattern": "^articles/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"},
          "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
        }
      }
    },
    "evidence_cutoff": {"type": "string", "format": "date"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
